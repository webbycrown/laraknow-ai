{
  "name": "webbycrown/laraknow-ai",
  "description": "LaraKnow AI is an AI-powered Laravel assistant package for building intelligent chatbots with database integration, tool calling, and structured AI responses.",
  "license": "MIT",
  "authors": [
    {
      "name": "WebbyCrown Solutions",
      "email": "info@webbycrown.com"
    }
  ],
  "keywords": [
    "laravel",
    "laraknow-ai",
    "ai",
    "chatbot",
    "assistant",
    "openai",
    "groq",
    "openrouter",
    "database-ai",
    "llm",
    "tool-calling"
  ],
  "require": {
    "php": "^8.3",
    "ext-mbstring": "*",
    "illuminate/support": "^12.0|^13.0",
    "laravel/ai": "^0.6.8"
  },
  "suggest": {
    "phpmyadmin/sql-parser": "Enables parser-backed SQL validation when laraknow.sql_validation.mode is set to auto or parser."
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Webbycrown\\LaraknowAi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Webbycrown\\LaraknowAi\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test:security": "vendor/bin/phpunit --testsuite Security",
    "test:unit": "vendor/bin/phpunit --testsuite Unit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Webbycrown\\LaraknowAi\\Providers\\LaraKnowAiServiceProvider"
      ],
      "aliases": {}
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
